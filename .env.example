# =============================================================================
# Custom Merch Platform - Environment Variables Example
# Copy to `.env` for local development.
# =============================================================================

# ----- Node Environment -----
NODE_ENV=development

# ----- API Service -----
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# ----- Web (Next.js) -----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ----- Admin (Next.js) -----
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000

# ----- Database (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=custom_merch
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custom_merch?schema=public

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- Object Storage (MinIO / S3-compatible) -----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=custom-merch-uploads
S3_FORCE_PATH_STYLE=true

# ----- Payment (placeholders for future work packages) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ----- AI Provider (placeholders) -----
AI_PROVIDER=mock
OPENAI_API_KEY=

# ----- Email Provider (placeholders) -----
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ----- Auth / Security -----
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d
