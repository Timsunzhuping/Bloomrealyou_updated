# =============================================================================
# Custom Merch Platform — Environment Variables (template)
# Copy to `.env` for local development. Production deploys should source the
# same variable names from a secret manager (AWS SSM / Vault / Doppler / ...).
# Variables marked REQUIRED have no safe default and the app will refuse to
# start without them in production.
# =============================================================================

# ----- Node / runtime -----
NODE_ENV=development

# ----- Public URLs (used in emails, CORS, share links) -----
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ----- API service -----
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
# Comma-separated allow-list. Leave unset in dev to reflect any origin.
API_CORS_ORIGINS=
# Optional global per-IP rate limit overrides (token-bucket).
API_RATE_LIMIT_BURST=120
API_RATE_LIMIT_REFILL_PER_SEC=10

# ----- Web (Next.js storefront) -----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ----- Admin (Next.js back-office) -----
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000

# ----- Database (PostgreSQL) — REQUIRED in prod -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=custom_merch
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custom_merch?schema=public

# ----- Redis (cache + BullMQ + idempotency) — REQUIRED in prod -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Selects which webhook idempotency backend to use.
IDEMPOTENCY_STORE_BACKEND=in-memory
# Selects the notifications queue. Set to `bullmq` and provide BULLMQ_REDIS_URL
# to share the workload across multiple API instances.
NOTIFICATIONS_QUEUE_DRIVER=in-memory
BULLMQ_REDIS_URL=

# ----- Object storage (S3-compatible / MinIO) — REQUIRED in prod -----
# In production the storage adapter expects the names below; the bracketed
# names exist in older docs and remain accepted aliases.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=custom-merch-uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=custom-merch-uploads
S3_FORCE_PATH_STYLE=true

# ----- Payments (Stripe + PayPal) — REQUIRED in prod -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Refuse unsigned webhook events (set to `true` in production).
STRIPE_WEBHOOK_REQUIRE_SIGNATURE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ----- AI provider (design generation, slogans, etc.) — defaults to mock -----
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- AI conversational agents (Sales Copilot / Support Agent) -----
# Provider for the chat agents: claude | openai | mock (default mock).
AI_AGENT_PROVIDER=mock
# Claude (primary) — used when AI_AGENT_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Per-user daily caps for agent usage (0 disables a given check).
AI_AGENT_MAX_TOKENS_PER_DAY=100000
AI_AGENT_MAX_COST_USD_PER_DAY=5
AI_AGENT_MAX_TURNS_PER_DAY=100

# ----- Email / notifications — defaults to mock in dev/CI -----
EMAIL_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
RESEND_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@bloomrealyou.com
SENDGRID_FROM_NAME=Bloomrealyou
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@bloomrealyou.com
EMAIL_FROM=no-reply@example.com

# ----- Shipping providers — defaults to mock in dev/CI -----
SHIPPING_PROVIDER=mock
EASYPOST_API_KEY=
SEVENTEENTRACK_API_KEY=
SHIPPO_API_KEY=

# ----- Auth / security — REQUIRED in prod (rotate quarterly) -----
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# ----- Observability (optional) -----
SENTRY_DSN=
LOG_LEVEL=info
