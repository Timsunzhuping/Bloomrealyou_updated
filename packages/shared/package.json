{
  "name": "@custom-merch/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, and utility functions across apps and packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@custom-merch/shared: no tests yet\"",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@custom-merch/config": "workspace:*",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4"
  }
}
