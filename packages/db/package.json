{
  "name": "@custom-merch/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and seed scripts for the platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc --noEmit",
    "test": "echo \"@custom-merch/db: no tests yet\"",
    "clean": "rimraf dist .turbo src/generated",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@custom-merch/shared": "workspace:*"
  },
  "devDependencies": {
    "@custom-merch/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
