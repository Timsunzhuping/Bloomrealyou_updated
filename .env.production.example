S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
S3_BUCKET=custom-merch-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://101.47.76.12/uploads

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_WEBHOOK_REQUIRE_SIGNATURE=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
