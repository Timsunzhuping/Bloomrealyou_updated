# =============================================================================
# Alibaba Cloud production env template (HK / Singapore region, no ICP).
# Copy to .env.production on the ECS host and fill every value.
# DO NOT commit real secrets.
#
# Two modes for stateful services:
#   (A) Managed  — RDS PostgreSQL + Tair(Redis) + OSS  (recommended for launch)
#   (B) In-stack — postgres/redis/minio containers      (staging / quick start)
# Lines tagged [A] vs [B] show which to use; delete the ones you don't need.
# =============================================================================

NODE_ENV=production
TZ=UTC
IMAGE_TAG=latest

# --- Public URLs (your real domains) ----------------------------------------
APP_URL=https://bloomrealyou.com
ADMIN_URL=https://admin.bloomrealyou.com
API_URL=https://api.bloomrealyou.com
API_BASE_URL=https://api.bloomrealyou.com
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=https://bloomrealyou.com,https://admin.bloomrealyou.com

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.bloomrealyou.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://api.bloomrealyou.com

# --- Database ----------------------------------------------------------------
# [A] Managed RDS — point at the VPC-INTERNAL endpoint; delete POSTGRES_* below
#     and remove the in-stack `postgres` service from docker-compose.prod.yml.
DATABASE_URL=postgresql://<user>:<password>@<rds-internal-host>:5432/bloomrealyou?schema=public
# [B] In-stack postgres (staging only):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bloomrealyou
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=bloomrealyou

# --- Redis / queue -----------------------------------------------------------
# [A] Managed Tair — use the VPC-internal endpoint + password.
REDIS_URL=redis://:<password>@<redis-internal-host>:6379
BULLMQ_REDIS_URL=redis://:<password>@<redis-internal-host>:6379
# [B] In-stack redis (staging only): REDIS_URL=redis://redis:6379
IDEMPOTENCY_STORE_BACKEND=redis
NOTIFICATIONS_QUEUE_DRIVER=bullmq

# --- Object storage ----------------------------------------------------------
# [B] MinIO in-stack (works with the existing S3 adapter today):
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=bloomrealyou-uploads
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
S3_BUCKET=bloomrealyou-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://api.bloomrealyou.com/uploads
# [A] OSS — requires an OSS storage adapter (roadmap Phase 4); OSS is NOT
#     natively S3-API compatible, so keep MinIO until that adapter lands.

# --- Auth / security ---------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# --- Payments (Stripe + PayPal) ---------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_REQUIRE_SIGNATURE=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_REQUIRE_SIGNATURE=true
NEXT_PUBLIC_ENABLE_PAYPAL_CHECKOUT=false

# --- AI (OpenAI for global; mock if unset) ----------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_GENERATION_DAILY_LIMIT=20
AI_FEATURE_ENABLED=true

# --- Email / notifications ---------------------------------------------------
NOTIFICATION_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@bloomrealyou.com
SENDGRID_FROM_NAME=Bloomrealyou

# --- Shipping ----------------------------------------------------------------
SHIPPING_PROVIDER=easypost
EASYPOST_API_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
