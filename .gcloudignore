# Files excluded from `gcloud builds submit` upload — keeps the build context
# small and the build fast. Mirrors .gitignore plus a few build-time extras.

.git
.gitignore
.github
.vscode
.idea

node_modules
**/node_modules

# Build outputs (Docker rebuilds these inside the image).
dist
**/dist
.next
**/.next
.turbo
**/.turbo
coverage
**/coverage

# Environment / secrets — never bake into the image.
.env
.env.*
!.env.example

# Frontends are deployed to Vercel, not Cloud Run.
apps/web
apps/admin

# Tests, docs, and fixtures aren't needed at runtime.
tests
docs
*.md
!README.md

# Editor / OS noise.
.DS_Store
*.log
*.tgz
